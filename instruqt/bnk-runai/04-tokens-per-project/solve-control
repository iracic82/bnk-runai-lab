#!/usr/bin/env bash
# Idempotent: more traffic only raises the counters.
export KUBECONFIG=/etc/kubernetes/admin.conf
labctl load steady --tenant tenant-a --seconds 30
labctl load steady --tenant tenant-b --seconds 15
for i in $(seq 1 36); do
  v=$(kubectl -n bnk-runai-tenancy get cm bnk-runai-usage -o jsonpath='{.data.project\.tenant-a}' 2>/dev/null)
  case "$v" in ''|*[!0-9]*) ;; *) [ "$v" -gt 0 ] && exit 0 ;; esac
  sleep 5
done
echo "no ledger total for tenant-a" >&2
exit 1
