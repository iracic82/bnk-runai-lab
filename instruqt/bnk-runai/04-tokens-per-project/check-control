#!/usr/bin/env bash
export KUBECONFIG=/etc/kubernetes/admin.conf
kubectl get projects.kai.resources tenant-a >/dev/null 2>&1 || { fail-message "Run:ai project tenant-a does not exist. Finish challenge 2 first."; exit 1; }
v=$(kubectl get projects.kai.resources tenant-a -o jsonpath='{.metadata.annotations.tenancy\.f5\.com/tokens-total}' 2>/dev/null)
case "$v" in ''|*[!0-9.]*) v=0 ;; esac
awk "BEGIN{exit !($v > 0)}" || { fail-message "Project tenant-a has no tenancy.f5.com/tokens-total yet. Send traffic (labctl load steady --tenant tenant-a --seconds 45) and wait for the meter to write it back."; exit 1; }
exit 0
