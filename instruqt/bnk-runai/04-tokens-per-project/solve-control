#!/usr/bin/env bash
# Idempotent: more traffic only raises the counters.
export KUBECONFIG=/etc/kubernetes/admin.conf
labctl load steady --tenant tenant-a --seconds 30
labctl load steady --tenant tenant-b --seconds 15
for i in $(seq 1 36); do
  v=$(kubectl get projects.kai.resources tenant-a -o jsonpath='{.metadata.annotations.tenancy\.f5\.com/tokens-total}' 2>/dev/null)
  case "$v" in ''|*[!0-9.]*) ;; *) awk "BEGIN{exit !($v > 0)}" && exit 0 ;; esac
  sleep 5
done
echo "tokens-total annotation did not appear on tenant-a" >&2
exit 1
