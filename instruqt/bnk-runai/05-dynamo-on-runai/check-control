#!/usr/bin/env bash
set -euo pipefail
export KUBECONFIG=/etc/kubernetes/admin.conf

NS=$(kubectl get projects.kai.resources dynamo -o jsonpath='{.status.namespace}' 2>/dev/null || true)
if [ -z "$NS" ]; then
  fail-message "There is no Run:ai project 'dynamo' with a namespace yet. Run: bash /root/lab/platform/dynamo/deploy.sh"
  exit 1
fi

if [ "$(kubectl -n "$NS" get dynamographdeployment mocker -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" != True ]; then
  fail-message "The DynamoGraphDeployment 'mocker' in $NS is not Ready yet."
  exit 1
fi

workers=$(kubectl -n "$NS" get pods -l nvidia.com/dynamo-graph-deployment-name=mocker,nvidia.com/dynamo-component-type=decode \
  -o jsonpath='{range .items[?(@.status.phase=="Running")]}{.spec.schedulerName}{"\n"}{end}')
if [ "$(grep -c . <<<"$workers")" -lt 2 ]; then
  fail-message "Expected 2 Dynamo workers Running in $NS."
  exit 1
fi
if grep -vq '^runai-scheduler$' <<<"$workers"; then
  fail-message "Some Dynamo workers were not scheduled by the Run:ai scheduler (runai-scheduler)."
  exit 1
fi

if [ "$(kubectl -n "$NS" get f5-epps model-pool-epp -o jsonpath='{.spec.engine}' 2>/dev/null)" != dynamo ]; then
  fail-message "BNK's Endpoint Picker for the dynamo project is not in Dynamo mode. Is the tenancy controller running?"
  exit 1
fi

VIP=$(kubectl get gateways.gateway.networking.k8s.io -n f5-bnk dynamo -o jsonpath='{.spec.addresses[0].value}' 2>/dev/null || true)
if [ -z "$VIP" ]; then
  fail-message "BNK has no Gateway dynamo yet. Is the tenancy controller running?"
  exit 1
fi

# The picker names the worker in the request; a 200 carrying decode_worker_id means BNK picked a real worker.
body=$(curl -s --max-time 20 "http://$VIP:8000/v1/chat/completions" -H 'Content-Type: application/json' \
  -d '{"model":"Qwen/Qwen3-0.6B","max_tokens":4,"nvext":{"extra_fields":["worker_id"]},"messages":[{"role":"user","content":"check"}]}' || true)
if ! grep -q decode_worker_id <<<"$body"; then
  fail-message "A request through the BNK VIP $VIP:8000 was not served by a Dynamo worker: ${body:0:160}"
  exit 1
fi
