#!/usr/bin/env bash
export KUBECONFIG=/etc/kubernetes/admin.conf
kubectl get projects.kai.resources tenant-a >/dev/null 2>&1 || { fail-message "Run:ai project tenant-a does not exist. Finish challenge 2 first."; exit 1; }
v=$(kubectl -n bnk-runai-tenancy get cm bnk-runai-usage -o jsonpath='{.data.project\.tenant-a}' 2>/dev/null)
case "$v" in ''|*[!0-9]*) v=0 ;; esac
[ "$v" -gt 0 ] || { fail-message "No metered tokens for tenant-a in the usage ledger yet. Send traffic (labctl load steady --tenant tenant-a --seconds 45) and wait 30 seconds for the meter to write it."; exit 1; }
exit 0
