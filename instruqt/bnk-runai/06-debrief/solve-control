#!/usr/bin/env bash
export KUBECONFIG=/etc/kubernetes/admin.conf
# The agent when an LLM key is set, the scripted demo otherwise; both create agent-demo through Run:ai MCP.
if [ -s /root/.config/lab/llm.env ]; then
  AGENT_AUTO_APPROVE=1 python3 /root/lab/platform/mcp/agent.py \
    "Create a Run:ai project called agent-demo with 1 GPU and tell me its BNK endpoint" || true
fi
kubectl get projects.kai.resources agent-demo >/dev/null 2>&1 || bash /root/lab/platform/mcp/demo.sh agent-demo 1
/root/lab/labctl/labctl model deploy agent-demo
